            <specular>0.04 0.04 0.04 1</specular>
          </material>

        </visual>


      </link>

    </model>


    <!-- RESPONSE PAD -->

    <model name="response_pad">

      <static>true</static>

      <link name="pad">

        
        <visual name="pad_surface">
          <pose>3.0 2.2 0.11 0 0 0</pose>

          <geometry>
            <cylinder>
              <radius>1.65</radius>
              <length>0.07</length>
            </cylinder>
          </geometry>

          
          <material>
            <ambient>0.38 0.24 0.22 1</ambient>
