            <specular>0.04 0.04 0.04 1</specular>
          </material>

        </visual>


      </link>

    </model>


    <!-- RECON DRONE -->

    <include>

      <uri>model://iris_with_gimbal_recon</uri>

      <name>recon_drone</name>

      <pose degrees="true">
        -3.0 2.2 0.25 0 0 90
      </pose>

    </include>


    <!-- RESPONSE DRONE -->

    <include>

      <uri>model://iris_with_gimbal_response</uri>

      <name>response_drone</name>

      <pose degrees="true">
        3.0 2.2 0.25 0 0 90
      </pose>

    </include>


