import time
import math
import argparse
from pymavlink import mavutil

DEFAULT_CONNECTION = '/dev/ttyACM0'
DEFAULT_BAUD = 115200

def heartbeat_source(msg):
    return msg.get_srcSystem(), msg.get_srcComponent()

def initialize_target_from_heartbeat(mav, heartbeat):
    source_system, source_component = heartbeat_source(heartbeat)
    print("HEARTBEAT source system/component: " + str(source_system) + "/" + str(source_component))
    print("Connection target before init:     " + str(mav.target_system) + "/" + str(mav.target_component))

    if source_system:
        mav.target_system = source_system
    if source_component:
        mav.target_component = source_component

    print("Connection target after init:      " + str(mav.target_system) + "/" + str(mav.target_component))
    return mav.target_system, mav.target_component

def request_data_streams(mav, rate_hz=4):
    print("Requesting MAVLink data streams at " + str(rate_hz) + " Hz...")
    mav.mav.request_data_stream_send(
        mav.target_system,
        mav.target_component,
        mavutil.mavlink.MAV_DATA_STREAM_ALL,
        rate_hz,
        1
    )

def main():
    parser = argparse.ArgumentParser(description="Test real MAVLink telemetry from the Orange Cube.")
    parser.add_argument("--device", default=DEFAULT_CONNECTION, help="MAVLink serial device")
    parser.add_argument("--baud", type=int, default=DEFAULT_BAUD, help="MAVLink serial baudrate")
    parser.add_argument("--duration", type=float, default=8.0, help="Seconds to print telemetry")
    args = parser.parse_args()

    print("Connecting directly to MAVLink telemetry on " + args.device + " at " + str(args.baud) + " baud...")
    mav = mavutil.mavlink_connection(args.device, baud=args.baud)
    
    print("Waiting for heartbeat...")
    heartbeat = mav.wait_heartbeat(timeout=10.0)
    if heartbeat is None:
        print("ERROR: Timeout waiting for heartbeat. Check Pixhawk connection.")
        print("No HEARTBEAT bytes were decoded on " + args.device + ".")
        print("Target system/component remains: " + str(mav.target_system) + "/" + str(mav.target_component))
        print("Confirm Cube power, UART TX/RX wiring, SERIALx_PROTOCOL=2, SERIALx_BAUD=115, and that no other reader owns the port.")
        return
        
    print("\n--- MAVLink Connection Established ---")
    initialize_target_from_heartbeat(mav, heartbeat)
    
    request_data_streams(mav, rate_hz=4)
    
    # Standard copter modes mapping
    copter_modes = {
        0: "STABILIZE", 1: "ACRO", 2: "ALT_HOLD", 3: "AUTO", 4: "GUIDED",
        5: "LOITER", 6: "RTL", 7: "CIRCLE", 9: "LAND", 11: "DRIFT",
        13: "SPORT", 14: "FLIP", 15: "AUTOTUNE", 16: "POSHOLD",
        17: "BRAKE", 18: "THROW", 19: "AVOID_ADSB", 20: "GUIDED_NOGPS",
        21: "SMART_RTL", 22: "FLOWHOLD", 23: "FOLLOW", 24: "ZIGZAG"
    }

    print("\nInitial HEARTBEAT:")
    armed = bool(heartbeat.base_mode & mavutil.mavlink.MAV_MODE_FLAG_SAFETY_ARMED)
    flight_mode = copter_modes.get(heartbeat.custom_mode, "UNKNOWN")
    print("  Vehicle Type:  " + str(heartbeat.type))
    print("  Flight Mode:   " + str(flight_mode))
    print("  Armed State:   " + ("ARMED" if armed else "DISARMED"))
    
    # Track metrics
    lat, lon, alt = None, None, None
    heading, pitch, roll = None, None, None
    fix_type, satellites = None, None
    
    start_time = time.time()
    while time.time() - start_time < args.duration:
        msg = mav.recv_match(blocking=True, timeout=0.5)
        if msg is None:
            continue
            
        msg_type = msg.get_type()
        if msg_type == 'HEARTBEAT':
            armed = bool(msg.base_mode & mavutil.mavlink.MAV_MODE_FLAG_SAFETY_ARMED)
            flight_mode = copter_modes.get(msg.custom_mode, "UNKNOWN")
            vehicle_type = msg.type
            print("\nHeartbeat Received:")
            print("  Vehicle Type:  " + str(vehicle_type))
            print("  Flight Mode:   " + str(flight_mode))
            print("  Armed State:   " + ("ARMED" if armed else "DISARMED"))
            
        elif msg_type == 'GLOBAL_POSITION_INT':
            lat = msg.lat / 1e7
            lon = msg.lon / 1e7
            alt = msg.relative_alt / 1000.0
            print("GLOBAL_POSITION_INT: lat=" + f"{lat:.7f}" + " lon=" + f"{lon:.7f}" + " rel_alt_m=" + f"{alt:.2f}")
            
        elif msg_type == 'ATTITUDE':
            roll = math.degrees(msg.roll)
            pitch = math.degrees(msg.pitch)
            heading = math.degrees(msg.yaw) % 360.0
            print("ATTITUDE: roll=" + f"{roll:.2f}" + " pitch=" + f"{pitch:.2f}" + " heading=" + f"{heading:.2f}")
            
        elif msg_type == 'GPS_RAW_INT':
            fix_type = msg.fix_type
            satellites = msg.satellites_visible
            print("GPS_RAW_INT: fix_type=" + str(fix_type) + " satellites=" + str(satellites))

    # Print final summary of telemetry values
    print("\n--- Latest Telemetry Summary ---")
    print("Latitude:    " + (f"{lat:.6f}" if lat is not None else "N/A"))
    print("Longitude:   " + (f"{lon:.6f}" if lon is not None else "N/A"))
    print("Altitude:    " + (f"{alt:.1f} m AGL" if alt is not None else "N/A"))
    print("Heading:     " + (f"{heading:.1f} deg" if heading is not None else "N/A"))
    print("Pitch:       " + (f"{pitch:.1f} deg" if pitch is not None else "N/A"))
    print("Roll:        " + (f"{roll:.1f} deg" if roll is not None else "N/A"))
    
    fix_map = {0: "No Fix", 1: "No Fix", 2: "2D Fix", 3: "3D Fix", 4: "DGPS", 5: "RTK Float", 6: "RTK Fixed"}
    fix_str = fix_map.get(fix_type, "Unknown")
    print("GPS Fix:     " + (f"{fix_str} ({fix_type})" if fix_type is not None else "N/A"))
    print("Satellites:  " + (str(satellites) if satellites is not None else "N/A"))

if __name__ == '__main__':
    main()
